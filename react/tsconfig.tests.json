{
  // Les tests vivent hors de src/ (src/ ne montre que l'application), mais tsc -b les vérifie aussi
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tests.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  "include": ["src", "tests"]
}
